# API
API_TITLE=Franq Data Assistant
API_AUTO_CREATE_SCHEMA=true

# PostgreSQL - estado durável do agente
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=desafio_franq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=3s
POSTGRES_HEALTHCHECK_RETRIES=10
AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/desafio_franq

# Redis - hot state e stream de eventos
REDIS_IMAGE=redis:7-alpine
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
REDIS_CONTAINER_PORT=6379
REDIS_KEY_PREFIX=franq
REDIS_HEALTHCHECK_INTERVAL=5s
REDIS_HEALTHCHECK_TIMEOUT=3s
REDIS_HEALTHCHECK_RETRIES=10
EXECUTION_HOT_STATE_TTL_SECONDS=21600
REDIS_STREAM_MAXLEN=5000
REDIS_STREAM_READ_BLOCK_MS=15000
REDIS_STREAM_READ_COUNT=100

# Banco do usuário - tool analítica do agente
USER_DATABASE_PATH=data/anexo_desafio_1.db
USER_DATABASE_CONNECTION_TIMEOUT_SECONDS=5.0
USER_DATABASE_QUERY_TIMEOUT_SECONDS=5.0
USER_DATABASE_MAX_ROWS=1000
USER_DATABASE_PROGRESS_HANDLER_STEPS=1000

# LLM
# Valores aceitos: openai | deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=60.0
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=medium
OPENAI_STORE=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60.0
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_REASONING_EFFORT=high

# Runtime do agente
AGENT_RUNTIME_MAX_ITERATIONS=8
AGENT_RUNTIME_MAX_SQL_RETRIES=3
AGENT_TOOL_MAX_CONCURRENCY_PER_TOOL=3

# Contexto
# A janela de contexto e a contagem de tokens vêm do modelo ativo.
AGENT_CONTEXT_BUDGET_PERCENT=25.0
AGENT_CONTEXT_SUMMARY_FALLBACK_MAX_MESSAGES=12
AGENT_CONTEXT_SUMMARY_FALLBACK_MAX_CHARS_PER_MESSAGE=800
AGENT_CONTEXT_RETRIEVER_DEFAULT_LIMIT=8
AGENT_CONTEXT_RETRIEVER_MAX_LIMIT=20

# Runner / Outbox
RUNNER_ID=runner-local
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=10
OUTBOX_RETRY_BASE_DELAY_SECONDS=2.0
OUTBOX_RETRY_MAX_DELAY_SECONDS=60.0
OUTBOX_RETRY_EXPONENT_CAP=5
